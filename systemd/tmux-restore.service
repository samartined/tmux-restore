[Unit]
Description=Save tmux sessions before shutdown and reboot (tmux-restore)
# After 5 failures in 5 minutes, stay failed instead of restarting forever
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# install.sh points this at the plugin's real location
ExecStart=%h/.tmux/plugins/tmux-restore/scripts/shutdown-save.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
