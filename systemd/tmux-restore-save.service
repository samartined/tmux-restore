[Unit]
Description=Save tmux sessions, attached or not (tmux-restore)

[Service]
Type=oneshot
# a hung tmux mustn't hold the timer up for good
TimeoutStartSec=2min
# tmux-resurrect parses tab-separated tmux output, which tmux mangles without a UTF-8 locale
Environment=LANG=C.UTF-8
# install.sh adds the directories of tmux and jq, which the user manager's PATH may lack
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# install.sh points this at the plugin's real location
ExecStart=%h/.tmux/plugins/tmux-restore/scripts/save-now.sh --periodic
